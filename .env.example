# ============================================================
# Digital Garden 3.0 — Cloud Environment Variables
# ============================================================
# 复制此文件为 .env.local 并填入真实值。
# 切勿将 .env.local 提交到 Git！
#
# 环境划分:
#   .env.local       — 本地开发（gitignored）
#   Vercel Dashboard — Preview / Production（加密存储）
# ============================================================

# ──────────────────────────────────────────────────────────
# 数据库（必填，服务端）
# ──────────────────────────────────────────────────────────
#
# 生产 (Neon PostgreSQL):
#   DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/garden?sslmode=require"
#
# 本地 PostgreSQL (Docker):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garden-dev"
#
# 本地 SQLite 回退（仅限开发，需同步修改 prisma/schema.prisma 的 provider）:
#   DATABASE_URL="file:./dev.db"
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garden-dev"

# ──────────────────────────────────────────────────────────
# Session 安全（推荐，服务端）
# ──────────────────────────────────────────────────────────
# 用于签名登录 Cookie，防止会话伪造。
# 生成方式: openssl rand -hex 32
# 不配置时使用明文 user ID 作为 Cookie 值（不安全）。
#
# SESSION_SECRET="your-64-char-random-hex-string"

# ──────────────────────────────────────────────────────────
# DeepSeek AI（可选，客户端配置优先）
# ──────────────────────────────────────────────────────────
# 当前架构: 用户在 Settings 页面输入 API Key → localStorage → HTTP Header
# 服务端 env var 作为 fallback（如果未来需要服务端默认 key）。
#
# 获取 API Key: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# ──────────────────────────────────────────────────────────
# Fish Audio TTS（可选，客户端配置）
# ──────────────────────────────────────────────────────────
# 用户在 Settings → TTS 页面输入 API Key → localStorage
# 未配置时不显示语音播放按钮。
#
# 获取 API Key: https://fish.audio/app/api-keys/
# FISH_AUDIO_API_KEY="sk-your-fish-audio-api-key"

# ──────────────────────────────────────────────────────────
# 应用公开地址（推荐，客户端 + 服务端）
# ──────────────────────────────────────────────────────────
# 用于生成绝对 URL（OAuth 回调、RSS、分享链接等）
# Vercel 预览部署自动注入 VERCEL_URL，无需手动配置。
# 生产环境设置自定义域名。
#
# NEXT_PUBLIC_APP_URL="https://garden.your-domain.com"

# ──────────────────────────────────────────────────────────
# CDN 静态资源（可选，Phase 2 基础设施已就绪）
# ──────────────────────────────────────────────────────────
# 大文件（音频 101MB + 背景 55MB + 主题 29MB）托管地址。
# 未配置时所有资源从 /public/ 本地加载。
# 配置后自动将 /audio/*, /backgrounds/*, /carousel/* 等路径重定向到 CDN。
#
# NEXT_PUBLIC_CDN_URL="https://cdn.your-domain.com"

# ──────────────────────────────────────────────────────────
# 对象存储（可选，用于用户上传持久化）
# ──────────────────────────────────────────────────────────
# Cloudflare R2 / S3 兼容存储。
# 当前用户上传使用浏览器 IndexedDB（不跨设备）。
# 配置后可实现服务端上传持久化。
#
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_BUCKET_NAME="garden-assets"
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# NEXT_PUBLIC_R2_URL="https://pub-<hash>.r2.dev"

# ──────────────────────────────────────────────────────────
# 以下为遗留变量（当前代码未使用，保留用于脚本兼容）
# ──────────────────────────────────────────────────────────
# GARDEN_USERNAME="Star.Li"
# GARDEN_PASSWORD="changeme-in-production"
